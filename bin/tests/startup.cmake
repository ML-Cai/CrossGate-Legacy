# Requires a Vulkan-capable desktop; the success case also needs the game files.
set(arguments --frames 240)
if(INVALID_RESOURCES)
    get_filename_component(clientDirectory "${CLIENT}" DIRECTORY)
    set(config "${clientDirectory}/client-invalid-resources.ini")
    file(WRITE "${config}" "[General]\nEngineRootPath=${clientDirectory}/missing-client-resources\n")
    list(APPEND arguments --settings "${config}")
endif()
execute_process(COMMAND "${CLIENT}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 50)
if(INVALID_RESOURCES)
    file(REMOVE "${config}")
endif()
set(log "${output}\n${errors}")
if(INVALID_RESOURCES)
    if(NOT "${status}" STREQUAL "1" OR NOT log MATCHES "Failed to initialize asset readers")
        message(FATAL_ERROR "Missing resources were not reported correctly (${status}):\n${log}")
    endif()
    if(log MATCHES "All assets readers initialized successfully")
        message(FATAL_ERROR "Invalid readers were marked as ready:\n${log}")
    endif()
elseif(NOT "${status}" STREQUAL "0" OR NOT log MATCHES "All assets readers initialized successfully")
    message(FATAL_ERROR "Client failed to initialize (${status}):\n${log}")
endif()
if(NOT log MATCHES "Engine close" OR log MATCHES "VUID-|Validation Error")
    message(FATAL_ERROR "Unclean shutdown or Vulkan validation error:\n${log}")
endif()
