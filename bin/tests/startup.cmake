# Defaults also support invoking this script outside CTest.
if(NOT DEFINED STARTUP_FRAMES)
    set(STARTUP_FRAMES 240)
endif()
if(NOT DEFINED STARTUP_TIMEOUT)
    set(STARTUP_TIMEOUT 50)
endif()
# Requires a Vulkan-capable desktop; the success case also needs the game files.
set(arguments --frames ${STARTUP_FRAMES})
get_filename_component(clientDirectory "${CLIENT}" DIRECTORY)
if(INVALID_RESOURCES)
    set(config "${clientDirectory}/client-invalid-resources.ini")
    file(WRITE "${config}" "[General]\nEngineRootPath=${clientDirectory}/missing-client-resources\n")
    list(APPEND arguments --settings "${config}")
elseif(INVALID_ANIMATION)
    set(config "${clientDirectory}/client-invalid-animation-${INVALID_ANIMATION}.ini")
    file(READ "${clientDirectory}/settings.ini" content)
    if(INVALID_ANIMATION STREQUAL "direction")
        string(APPEND content "\n[Animation]\nDirection=99\n")
    elseif(INVALID_ANIMATION STREQUAL "serial")
        string(APPEND content "\n[Animation]\nSerialNum=0\n")
    elseif(INVALID_ANIMATION STREQUAL "scale")
        string(APPEND content "\n[Display]\nViewportScale=0\n")
    elseif(INVALID_ANIMATION STREQUAL "version")
        string(APPEND content "\n[Animation]\nVersion=99\n")
    elseif(INVALID_ANIMATION STREQUAL "frame")
        string(APPEND content "\n[Animation]\nStartFrame=4294967295\nPaused=true\n")
    endif()
    file(WRITE "${config}" "${content}")
    list(APPEND arguments --settings "${config}")
elseif(ANIMATION_REFERENCE)
    if(ANIMATION_REFERENCE STREQUAL "classic")
        set(version 0)
        set(serial 100000)
    elseif(ANIMATION_REFERENCE STREQUAL "puk2")
        set(version 3)
        set(serial 110300)
    elseif(ANIMATION_REFERENCE STREQUAL "puk3")
        set(version 4)
        set(serial 110505)
    else()
        message(FATAL_ERROR "Unknown animation reference case")
    endif()
    set(config "${clientDirectory}/client-reference-${ANIMATION_REFERENCE}.ini")
    file(READ "${clientDirectory}/settings.ini" content)
    string(APPEND content "\n[Map]\nFilePath=\n[Animation]\nVersion=${version}\nSerialNum=${serial}\nDirection=7\nMotion=0\nPaused=true\nStartFrame=1\n[Display]\nValidation=true\n")
    file(WRITE "${config}" "${content}")
    list(APPEND arguments --settings "${config}")
endif()
execute_process(COMMAND "${CLIENT}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${STARTUP_TIMEOUT})
if(config)
    file(REMOVE "${config}")
endif()
set(log "${output}\n${errors}")
if(ANIMATION_REFERENCE)
    set(expected "Animation preview ready: version=${version}, serial=${serial}, direction=7, motion=0, frame=1, paused=1")
    string(FIND "${log}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Native reference did not select the requested paused frame:\n${log}")
    endif()
endif()
if(INVALID_RESOURCES)
    if(NOT "${status}" STREQUAL "1" OR NOT log MATCHES "Failed to initialize asset readers")
        message(FATAL_ERROR "Missing resources were not reported correctly (${status}):\n${log}")
    endif()
    if(log MATCHES "All assets readers initialized successfully")
        message(FATAL_ERROR "Invalid readers were marked as ready:\n${log}")
    endif()
elseif(INVALID_ANIMATION)
    if(NOT "${status}" STREQUAL "1" OR NOT log MATCHES "Character animation failed:")
        message(FATAL_ERROR "Invalid animation was not reported correctly (${status}):\n${log}")
    endif()
elseif(NOT "${status}" STREQUAL "0" OR NOT log MATCHES "Character animation ready:")
    message(FATAL_ERROR "Client failed to initialize (${status}):\n${log}")
endif()
if(NOT INVALID_RESOURCES AND NOT INVALID_ANIMATION AND
   (NOT log MATCHES "Init scene exited" OR NOT log MATCHES "Animation scene entered" OR
    NOT log MATCHES "Animation scene exited"))
    message(FATAL_ERROR "Client did not complete the loading/animation scene lifecycle:\n${log}")
endif()
if(NOT INVALID_RESOURCES AND NOT INVALID_ANIMATION)
    string(REGEX MATCHALL "Character animation ready:" uploads "${log}")
    list(LENGTH uploads uploadCount)
    if(NOT uploadCount EQUAL 1)
        message(FATAL_ERROR "The preview must upload one shared clip:\n${log}")
    endif()
endif()
if(NOT log MATCHES "Engine close" OR log MATCHES "VUID-|Validation Error")
    message(FATAL_ERROR "Unclean shutdown or Vulkan validation error:\n${log}")
endif()
